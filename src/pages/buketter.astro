---
// src/pages/buketter.astro
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Buketter | Solé Vasa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-vanilla: #FAF8F5;
      --bg-card: #F4F0E8;
      --text-main: #141414;
      --text-muted: #625E56;
      --accent-orange: #C97A52;
      --border-color: #EAE5DA;
      --font-heading: 'Italiana', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg-vanilla); color: var(--text-main); font-family: var(--font-body); }
    header { border-bottom: 1px solid var(--border-color); padding: 1.4rem 2rem; display: flex; justify-content: space-between; align-items: center; max-width: 1140px; margin: 0 auto; }
    .brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: inherit; font-family: var(--font-heading); font-size: 2.2rem; }
    .back { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-muted); text-decoration: none; }
    main { max-width: 1140px; margin: 0 auto; padding: 4.5rem 2rem 6rem; }
    .intro { text-align: center; max-width: 720px; margin: 0 auto 4rem; }
    h1 { font-family: var(--font-heading); font-size: 3.2rem; margin-bottom: 0.8rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem; }
    .card { display: flex; flex-direction: column; }
    .card img { width: 100%; aspect-ratio: 4/5; object-fit: cover; background: var(--bg-card); margin-bottom: 1rem; border-radius: 2px; }
    .card-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem; }
    .card-title { font-family: var(--font-heading); font-size: 1.45rem; }
    .card-price { font-weight: 600; color: var(--accent-orange); font-size: 0.88rem; }
    .card-desc { font-size: 0.86rem; color: var(--text-muted); font-weight: 300; }
    .cta-box { background: var(--bg-card); padding: 3rem 2rem; text-align: center; margin-top: 5rem; border-radius: 2px; }
    .cta-box a { display: inline-block; background: var(--text-main); color: var(--bg-vanilla); padding: 0.85rem 2rem; border-radius: 999px; text-decoration: none; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 1rem; }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand"><img src="/flower.png" alt="Solé Vasa" style="width:34px; height:34px;" />Solé Vasa</a>
    <a href="/" class="back">&larr; Tillbaka till start</a>
  </header>
  <main>
    <div class="intro">
      <h1>Buketter</h1>
      <p style="color:var(--text-muted);">Dagsfärska, handbundna buketter med säsongens vackraste snittblommor.</p>
    </div>
    <div class="grid">
      <div class="card">
        <img src="/blom1.jpeg" alt="Signaturbukett Vasa" />
        <div class="card-head"><h2 class="card-title">Signaturbukett Vasa</h2><span class="card-price">från 450 kr</span></div>
        <p class="card-desc">Vild och fyllig signaturkomposition i varma toner.</p>
      </div>
      <div class="card">
        <img src="/blom2.jpeg" alt="Pastell & Knopp" />
        <div class="card-head"><h2 class="card-title">Pastell &amp; Knopp</h2><span class="card-price">från 520 kr</span></div>
        <p class="card-desc">Skira pastellnyanser med pudriga rosor och ranunkler.</p>
      </div>
      <div class="card">
        <img src="/blom5.jpeg" alt="Vild Trädgårdsbunt" />
        <div class="card-head"><h2 class="card-title">Vild Trädgårdsbunt</h2><span class="card-price">från 380 kr</span></div>
        <p class="card-desc">Luftigt bunden bukett med naturlig ängskänsla.</p>
      </div>
      <div class="card">
        <img src="/blom6.jpeg" alt="Fredagsbuketten" />
        <div class="card-head"><h2 class="card-title">Fredagsbuketten</h2><span class="card-price">från 490 kr</span></div>
        <p class="card-desc">Veckans utvalda säsongskombination som sätter helgkänslan.</p>
      </div>
      <div class="card">
        <img src="/blom7.jpeg" alt="Knopp & Solé" />
        <div class="card-head"><h2 class="card-title">Knopp &amp; Solé</h2><span class="card-price">från 580 kr</span></div>
        <p class="card-desc">Större arrangemang med skulpturala blomhuvuden.</p>
      </div>
      <div class="card">
        <img src="/blom8.jpeg" alt="Grand Vasa Special" />
        <div class="card-head"><h2 class="card-title">Grand Vasa Special</h2><span class="card-price">från 850 kr</span></div>
        <p class="card-desc">Ett storslaget mästerverk för speciella firanden och bemärkelsedagar.</p>
      </div>
    </div>
    <div class="cta-box">
      <h2>Beställ för upphämtning eller bud</h2>
      <p style="color:var(--text-muted); margin-top:0.4rem;">Ring butiken så sätter vi ihop buketten efter dina önskemål.</p>
      <a href="tel:031134900">Ring 031-13 49 00</a>
    </div>
  </main>
</body>
</html>