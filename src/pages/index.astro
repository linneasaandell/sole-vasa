---
// src/pages/index.astro
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Solé Vasa | Flower Shop & Botanik i Vasastan</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-vanilla: #FAF8F5;
      --bg-card: #F4F0E8;
      --text-main: #141414;
      --text-muted: #625E56;
      --accent-orange: #C97A52;
      
      --peach-diffuse: #E8B49B;
      --peach-hover: #DF9F82;
      
      --border-color: #EAE5DA;
      --max-w: 1140px;

      --font-heading: 'Italiana', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-vanilla);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: var(--font-heading);
      letter-spacing: 0.03em;
      font-weight: 400;
    }

    .top-bar {
      background-color: var(--text-main);
      color: var(--bg-vanilla);
      text-align: center;
      padding: 0.5rem 1rem;
      font-size: 0.74rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 400;
    }

    .top-bar span {
      font-family: var(--font-body);
      font-weight: 600;
    }

    header {
      background: var(--bg-vanilla);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .nav-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.8rem 2rem 1.3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.2rem;
    }

    .brand-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: var(--text-main);
      gap: 0.45rem;
    }

    .flower-logo-img {
      width: 52px;
      height: 52px;
      object-fit: contain;
      display: block;
      margin-bottom: 0.2rem;
      transition: transform 0.25s ease;
    }

    .brand-box:hover .flower-logo-img {
      transform: scale(1.05);
    }

    /* Ännu större rubrik */
    .brand-title {
      font-family: var(--font-heading);
      font-size: clamp(2.8rem, 5.5vw, 4.2rem);
      letter-spacing: 0.08em;
      line-height: 1;
    }

    .brand-sub {
      font-family: var(--font-body);
      font-size: 0.88rem;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      color: var(--text-main);
      font-weight: 600;
      margin-top: 0.35rem;
    }

    nav {
      display: flex;
      gap: 2.6rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    nav a {
      font-size: 0.8rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 500;
      transition: color 0.2s ease;
    }

    nav a:hover {
      color: var(--accent-orange);
    }

    .hero {
      position: relative;
      height: 74vh;
      min-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #FFFFFF;
      overflow: hidden;
    }

    .hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: brightness(0.78);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 860px;
      padding: 2rem;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.35);
    }

    .hero-tag {
      font-size: 0.75rem;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      margin-bottom: 1rem;
      display: inline-block;
      font-weight: 300;
      color: var(--bg-vanilla);
    }

    .hero h1 {
      font-size: clamp(2.4rem, 5vw, 4rem);
      line-height: 1.2;
      margin-bottom: 2rem;
    }

    .btn-minimal {
      display: inline-block;
      border: 1px solid var(--bg-vanilla);
      background: rgba(20, 20, 20, 0.35);
      backdrop-filter: blur(8px);
      color: var(--bg-vanilla);
      padding: 0.85rem 2.2rem;
      font-size: 0.74rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 999px;
      transition: all 0.3s ease;
      font-weight: 400;
    }

    .btn-minimal:hover {
      background: var(--accent-orange);
      border-color: var(--accent-orange);
      color: #FFFFFF;
    }

    .intro-offer-section {
      width: 100%;
      padding: 6.5rem 2rem 5rem;
    }

    .intro-offer-box {
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }

    .intro-offer-box h2 {
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      line-height: 1.2;
      margin-bottom: 1.5rem;
      color: var(--text-main);
    }

    .intro-offer-box p {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.8;
      margin-bottom: 2rem;
      font-weight: 300;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .intro-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.82rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-orange);
      text-decoration: none;
      font-weight: 600;
      border-bottom: 1.5px solid var(--accent-orange);
      padding-bottom: 2px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .intro-link:hover {
      color: var(--text-main);
      border-color: var(--text-main);
    }

    .category-grid {
      max-width: var(--max-w);
      margin: 0 auto 7.5rem;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }

    .category-card {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      position: relative;
    }

    .card-img-wrap {
      aspect-ratio: 3 / 4;
      overflow: hidden;
      background: var(--bg-card);
      border-radius: 2px;
      margin-bottom: 1.2rem;
      pointer-events: none;
    }

    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      display: block;
    }

    .category-card:hover .card-img-wrap img {
      transform: scale(1.04);
    }

    .card-title {
      font-size: 1.65rem;
      margin-bottom: 0.3rem;
      color: var(--text-main);
      pointer-events: none;
      transition: color 0.2s ease;
    }

    .category-card:hover .card-title {
      color: var(--accent-orange);
    }

    .card-desc {
      font-size: 0.84rem;
      color: var(--text-muted);
      font-weight: 300;
      margin-bottom: 1.3rem;
      line-height: 1.6;
      pointer-events: none;
    }

    .btn-category {
      align-self: flex-start;
      display: inline-block;
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.65rem 1.4rem;
      border-radius: 999px;
      background-color: var(--peach-diffuse);
      color: #1E1A17;
      border: 1px solid rgba(255, 255, 255, 0.6);
      font-weight: 500;
      box-shadow: 0 2px 8px rgba(232, 180, 155, 0.25);
      transition: all 0.25s ease;
      pointer-events: none;
    }

    .category-card:hover .btn-category {
      background-color: var(--peach-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(223, 159, 130, 0.35);
    }

    .gallery-section {
      max-width: var(--max-w);
      margin: 0 auto 7.5rem;
      padding: 0 2rem;
    }

    .section-title {
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 0.4rem;
      color: var(--text-main);
    }

    .section-subtitle {
      text-align: center;
      font-size: 0.76rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent-orange);
      margin-bottom: 3.5rem;
      font-weight: 500;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2.5rem;
    }

    .product-item {
      display: flex;
      flex-direction: column;
    }

    .product-img-wrap {
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: var(--bg-card);
      border-radius: 2px;
      margin-bottom: 1rem;
    }

    .product-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .product-item:hover .product-img-wrap img {
      transform: scale(1.03);
    }

    .product-info {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0 0.2rem;
    }

    .product-name {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      color: var(--text-main);
    }

    .product-price {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    .split-section {
      background: var(--bg-card);
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      padding: 4.5rem 2rem;
    }

    .split-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      align-items: center;
      gap: 3.5rem;
    }

    .split-image-box {
      width: 100%;
      max-height: 420px;
      border-radius: 4px;
      overflow: hidden;
    }

    .split-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .split-content {
      padding: 1rem 0;
    }

    .split-content h2 {
      font-size: clamp(2.3rem, 3.5vw, 3.2rem);
      line-height: 1.2;
      margin-bottom: 1.3rem;
      color: var(--text-main);
    }

    .split-content p {
      color: var(--text-muted);
      font-size: 0.96rem;
      line-height: 1.8;
      margin-bottom: 1.8rem;
      font-weight: 300;
    }

    .store-details {
      max-width: var(--max-w);
      margin: 7.5rem auto;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
      align-items: start;
    }

    .store-details h2 {
      font-size: 2.6rem;
      margin-bottom: 1rem;
      color: var(--text-main);
    }

    .contact-list {
      list-style: none;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .contact-label {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-orange);
      margin-bottom: 0.35rem;
      font-weight: 600;
    }

    .phone-box {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .phone-box a {
      font-family: var(--font-body);
      font-size: 1.35rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: var(--text-main);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .phone-box a:hover {
      color: var(--accent-orange);
    }

    .phone-type {
      font-size: 0.76rem;
      color: var(--text-muted);
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-right: 0.4rem;
    }

    .contact-val-simple {
      font-family: var(--font-body);
      font-size: 1.05rem;
      color: var(--text-main);
      text-decoration: none;
    }

    .contact-val-simple:hover {
      color: var(--accent-orange);
    }

    .form-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-top: 3px solid var(--accent-orange);
      padding: 2.8rem 2.4rem;
      border-radius: 2px;
    }

    .form-card h3 {
      font-size: 2.1rem;
      margin-bottom: 0.4rem;
      color: var(--text-main);
    }

    .form-card p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 2rem;
      font-weight: 300;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 0.35rem;
      color: var(--text-main);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.85rem 1rem;
      border: 1px solid var(--border-color);
      border-radius: 2px;
      background: #FFFFFF;
      font-family: var(--font-body);
      font-size: 0.92rem;
      color: var(--text-main);
      transition: border-color 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--accent-orange);
    }

    .btn-submit {
      width: 100%;
      text-align: center;
      background: var(--text-main);
      color: var(--bg-vanilla);
      padding: 1rem;
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border: none;
      border-radius: 999px;
      cursor: pointer;
      transition: background-color 0.2s ease;
      font-weight: 500;
      margin-top: 0.5rem;
    }

    .btn-submit:hover {
      background: var(--accent-orange);
      color: #FFFFFF;
    }

    footer {
      border-top: 1px solid var(--border-color);
      padding: 4rem 2rem 3rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 300;
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 860px) {
      .category-grid { grid-template-columns: 1fr; gap: 3rem; }
      .product-grid { grid-template-columns: 1fr; }
      .split-inner { grid-template-columns: 1fr; gap: 2rem; }
      .split-image-box { max-height: 320px; }
      .store-details { grid-template-columns: 1fr; gap: 3rem; }
      .form-card { padding: 2rem 1.5rem; }
    }
  </style>
</head>
<body>

  <div class="top-bar">
    Vasastan, Göteborg &bull; <span>031-13 49 00</span> &bull; <span>0735-82 49 05</span> &bull; @sole.vasa
  </div>

  <header>
    <div class="nav-inner">
      <a href="/" class="brand-box">
        <img 
          src="/flower.png" 
          alt="Solé Vasa" 
          class="flower-logo-img" 
          onerror="this.style.display='none'"
        />
        <span class="brand-title">Solé Vasa</span>
        <span class="brand-sub">FLOWER SHOP</span>
      </a>
      <nav>
        <a href="#blommor">Sortiment</a>
        <a href="#utvalt">Utvalda Buketter</a>
        <a href="#studion">Om Butiken</a>
        <a href="#kontakt">Besök &amp; Kontakt</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <img 
        src="/blom2.jpeg" 
        alt="Solé Vasa blomsterarrangemang" 
        class="hero-img"
      />
      <div class="hero-content reveal">
        <span class="hero-tag">Botanisk Studio i Vasastan</span>
        <h1>Din lokala blomsterbutik, för alla tillfällen</h1>
        <a href="#kontakt" class="btn-minimal">Beställ Bukett</a>
      </div>
    </section>

    <!-- INTRODUKTION -->
    <section class="intro-offer-section reveal">
      <div class="intro-offer-box">
        <h2>Säsongens blomster &amp; botaniskt hantverk</h2>
        <p>
          Vi binder personliga buketter för vardag och firande, skapar skräddarsydd blomsterdesign för bröllop och fest, samt handplockar gröna växter och krukor till hem och kontor.
        </p>
        <div>
          <a href="#kontakt" class="intro-link">Hör av dig med din förfrågan &rarr;</a>
        </div>
      </div>
    </section>

    <!-- KATEGORIER -->
    <section id="blommor" class="category-grid">
      <a href="/sasongens-buketter" class="category-card reveal">
        <div class="card-img-wrap">
          <img src="/blom1.jpeg" alt="Säsongens Buketter" />
        </div>
        <h2 class="card-title">Säsongens Buketter</h2>
        <p class="card-desc">Handplockade snittblommor med vilda och naturliga former.</p>
        <span class="btn-category">Se buketter &amp; priser &rarr;</span>
      </a>

      <a href="/brollop-och-fest" class="category-card reveal">
        <div class="card-img-wrap">
          <img src="/blom3.jpeg" alt="Bröllop och Fest" />
        </div>
        <h2 class="card-title">Bröllop &amp; Fest</h2>
        <p class="card-desc">Skräddarsydd blomsterdesign och binderi för livets stora stunder.</p>
        <span class="btn-category">Se bröllop &amp; priser &rarr;</span>
      </a>

      <a href="/krukvaxter-och-gronska" class="category-card reveal">
        <div class="card-img-wrap">
          <img src="/blom4.jpeg" alt="Gröna Krukväxter" />
        </div>
        <h2 class="card-title">Krukväxter &amp; Grönska</h2>
        <p class="card-desc">Personligt utvalda gröna växter, sticklingar och keramik.</p>
        <span class="btn-category">Se växter &amp; priser &rarr;</span>
      </a>
    </section>

    <!-- GALLERI -->
    <section id="utvalt" class="gallery-section reveal">
      <h2 class="section-title">Utvalda Arrangemang</h2>
      <p class="section-subtitle">Dagsfärska skapelser från Vasastan</p>
      
      <div class="product-grid">
        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom5.jpeg" alt="Signaturbukett Vasa" />
          </div>
          <div class="product-info">
            <span class="product-name">Signaturbukett Vasa</span>
            <span class="product-price">från 450 kr</span>
          </div>
        </div>

        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom6.jpeg" alt="Säsongens Vilda Bunt" />
          </div>
          <div class="product-info">
            <span class="product-name">Säsongens Vilda Bunt</span>
            <span class="product-price">från 380 kr</span>
          </div>
        </div>

        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom7.jpeg" alt="Pastell & Knopp" />
          </div>
          <div class="product-info">
            <span class="product-name">Pastell &amp; Knopp</span>
            <span class="product-price">från 520 kr</span>
          </div>
        </div>

        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom8.jpeg" alt="Fredagsbuketten" />
          </div>
          <div class="product-info">
            <span class="product-name">Fredagsbuketten</span>
            <span class="product-price">från 490 kr</span>
          </div>
        </div>

        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom11.jpeg" alt="Bordsarrangemang" />
          </div>
          <div class="product-info">
            <span class="product-name">Bordsarrangemang</span>
            <span class="product-price">från 650 kr</span>
          </div>
        </div>

        <div class="product-item">
          <div class="product-img-wrap">
            <img src="/blom12.jpeg" alt="Brudbinderi Konsultation" />
          </div>
          <div class="product-info">
            <span class="product-name">Brudbinderi</span>
            <span class="product-price">Konsultation</span>
          </div>
        </div>
      </div>
    </section>

    <!-- OM STUDION -->
    <section id="studion" class="split-section">
      <div class="split-inner">
        <div class="split-image-box">
          <img 
            src="/blom7.jpeg" 
            alt="Solé Vasa studio" 
            class="split-image" 
          />
        </div>
        <div class="split-content reveal">
          <h2>En levande blomsterstudio i Vasastan.</h2>
          <p>
            Hos Solé Vasa skapar vi med naturens egna skiftningar som inspiration. Med personlig omsorg binder vi buketter som förmedlar känslor, oavsett om det är till ett bröllop, vardagens firande eller en stilla stund.
          </p>
          <p>
            Välkommen in i butiken för att botanisera bland säsongens vackraste snittblommor, gröna blad och genuint hantverk.
          </p>
          <a href="tel:031134900" class="btn-minimal" style="color: var(--text-main); border-color: var(--text-main); background: transparent;">
            Ring butiken: 031-13 49 00
          </a>
        </div>
      </div>
    </section>

    <!-- KONTAKT -->
    <section id="kontakt" class="store-details">
      <div class="reveal">
        <h2>Besök &amp; Kontakt</h2>
        <p style="color: var(--text-muted); font-weight: 300;">
          Kontakta oss för förfrågningar, blomsterbud, abonnemang eller konsultation inför bröllop och fest.
