---
// src/pages/brollop-och-fest.astro
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bröllop & Fest | Solé Vasa</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-vanilla: #FAF8F5;
      --bg-card: #F4F0E8;
      --text-main: #141414;
      --text-muted: #625E56;
      --accent-orange: #C97A52;
      --peach-diffuse: #E8B49B;
      --border-color: #EAE5DA;
      --max-w: 1140px;

      --font-heading: 'Italiana', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-vanilla);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    header {
      background: var(--bg-vanilla);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .header-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.4rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      text-decoration: none;
      color: var(--text-main);
    }

    .flower-logo-img {
      width: 36px;
      height: 36px;
      object-fit: contain;
    }

    .brand-text {
      font-family: var(--font-heading);
      font-size: 2.2rem;
      line-height: 1;
      letter-spacing: 0.05em;
    }

    .back-btn {
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 2px;
      transition: all 0.2s ease;
    }

    .back-btn:hover {
      color: var(--accent-orange);
      border-color: var(--accent-orange);
    }

    main {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 5rem 2rem 7rem;
    }

    .page-intro {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 5rem;
    }

    .page-tag {
      font-size: 0.74rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent-orange);
      margin-bottom: 0.8rem;
      display: block;
      font-weight: 500;
    }

    h1 {
      font-family: var(--font-heading);
      font-size: clamp(2.4rem, 4.5vw, 3.6rem);
      line-height: 1.2;
      margin-bottom: 1rem;
      font-weight: 400;
    }

    .page-lead {
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.8;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2.8rem;
      margin-bottom: 6rem;
    }

    .product-card {
      display: flex;
      flex-direction: column;
    }

    .card-img-wrap {
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: var(--bg-card);
      border-radius: 2px;
      margin-bottom: 1.1rem;
    }

    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .product-card:hover .card-img-wrap img {
      transform: scale(1.03);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.35rem;
    }

    .card-title {
      font-family: var(--font-heading);
      font-size: 1.45rem;
      color: var(--text-main);
      font-weight: 400;
    }

    .card-price {
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--accent-orange);
      letter-spacing: 0.04em;
    }

    .card-caption {
      font-size: 0.86rem;
      color: var(--text-muted);
      font-weight: 300;
      line-height: 1.6;
    }

    .order-box {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-top: 3px solid var(--accent-orange);
      padding: 3.5rem 2.5rem;
      text-align: center;
      border-radius: 2px;
    }

    .order-box h2 {
      font-family: var(--font-heading);
      font-size: 2.3rem;
      margin-bottom: 0.8rem;
      font-weight: 400;
    }

    .order-box p {
      color: var(--text-muted);
      max-width: 580px;
      margin: 0 auto 2rem;
      font-weight: 300;
    }

    .btn-contact {
      display: inline-block;
      background: var(--text-main);
      color: var(--bg-vanilla);
      padding: 0.95rem 2.4rem;
      font-size: 0.76rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 999px;
      transition: background-color 0.2s ease;
      font-weight: 500;
    }

    .btn-contact:hover {
      background: var(--accent-orange);
      color: #FFFFFF;
    }

    footer {
      border-top: 1px solid var(--border-color);
      padding: 3.5rem 2rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 300;
    }

    @media (max-width: 860px) {
      .product-grid { grid-template-columns: 1fr; gap: 3rem; }
      main { padding: 3.5rem 1.5rem 5rem; }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="brand-link">
        <img src="/flower.png" alt="Solé Vasa" class="flower-logo-img" onerror="this.style.display='none'" />
        <span class="brand-text">Solé Vasa</span>
      </a>
      <a href="/" class="back-btn">&larr; Tillbaka till startsidan</a>
    </div>
  </header>

  <main>
    <div class="page-intro">
      <span class="page-tag">Skräddarsydd Design</span>
      <h1>Bröllop &amp; Fest</h1>
      <p class="page-lead">
        Blomsterarrangemang skapade för livets största ögonblick. Vi komponerar allt från brudbuketter till helhetskoncept för vigsel och festmiddag.
      </p>
    </div>

    <div class="product-grid">
      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom3.jpeg" alt="Brudbukett Botanisk" /></div>
        <div class="card-header">
          <h2 class="card-title">Brudbukett Botanisk</h2>
          <span class="card-price">från 1 400 kr</span>
        </div>
        <p class="card-caption">Skräddarsydd efter brudpar, stil och säsongens mest eleganta stjälkar.</p>
      </div>

      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom12.jpeg" alt="Tärnbukett" /></div>
        <div class="card-header">
          <h2 class="card-title">Tärnbukett</h2>
          <span class="card-price">från 650 kr</span>
        </div>
        <p class="card-caption">Ett harmoniskt, mindre syskonarrangemang i samma färgskala.</p>
      </div>

      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom11.jpeg" alt="Bordsdekorationer" /></div>
        <div class="card-header">
          <h2 class="card-title">Bordsdekorationer</h2>
          <span class="card-price">från 550 kr / st</span>
        </div>
        <p class="card-caption">Låga och fylliga bordsuppsättningar för festliga middagsdukningar.</p>
      </div>

      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom9.jpeg" alt="Corsage & Knapphål" /></div>
        <div class="card-header">
          <h2 class="card-title">Corsage / Knapphål</h2>
          <span class="card-price">från 195 kr</span>
        </div>
        <p class="card-caption">Stilfulla och precisa blomsterdetaljer för kavajslaget.</p>
      </div>

      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom10.jpeg" alt="Blomsterbåge & Fond" /></div>
        <div class="card-header">
          <h2 class="card-title">Blomsterbåge &amp; Fond</h2>
          <span class="card-price">Offert</span>
        </div>
        <p class="card-caption">Skulpturala installationer och valv för vigselplats och festlokal.</p>
      </div>

      <div class="product-card">
        <div class="card-img-wrap"><img src="/blom7.jpeg" alt="Bröllopskonsultation" /></div>
        <div class="card-header">
          <h2 class="card-title">Konsultationsmöte</h2>
          <span class="card-price">Kostnadsfritt</span>
        </div>
        <p class="card-caption">Vi möts i studion i Vasastan för att gå igenom era önskemål och datum.</p>
      </div>
    </div>

    <div class="order-box">
      <h2>Planerar ni bröllop eller festligt evenemang?</h2>
      <p>Skicka en förfrågan till flowers@solevasa.se eller ring oss så bokar vi in ett personligt möte.</p>
      <a href="mailto:flowers@solevasa.se?subject=Bröllopsförfrågan Solé Vasa" class="btn-contact">Maila flowers@solevasa.se</a>
    </div>
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} Solé Vasa &bull; FLOWER SHOP &bull; Vasastan, Göteborg</p>
  </footer>

</body>
</html>